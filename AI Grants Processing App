DATA_FILE = Path(__file__).with_name("grants_data.json")
DATE_FORMAT = "%Y-%m-%d"
DATETIME_FORMAT = f"{DATE_FORMAT} %H:%M"


class GrantStatus(str, Enum):
    DRAFT = "draft"
    SUBMITTED = "submitted"
    UNDER_REVIEW = "under_review"
    APPROVED = "approved"
    REJECTED = "rejected"
    WITHDRAWN = "withdrawn"

    @classmethod
    def choices(cls) -> list[str]:
        return [s.value for s in cls]

    @property
    def label(self) -> str:
        labels = {
            GrantStatus.DRAFT: "Draft",
            GrantStatus.SUBMITTED: "Submitted",
            GrantStatus.UNDER_REVIEW: "Under Review",
            GrantStatus.APPROVED: "Approved",
            GrantStatus.REJECTED: "Rejected",
            GrantStatus.WITHDRAWN: "Withdrawn",
        }
        return labels[self]


VALID_TRANSITIONS: dict[GrantStatus, set[GrantStatus]] = {
    GrantStatus.DRAFT: {GrantStatus.SUBMITTED, GrantStatus.WITHDRAWN},
    GrantStatus.SUBMITTED: {GrantStatus.UNDER_REVIEW, GrantStatus.WITHDRAWN, GrantStatus.DRAFT},
    GrantStatus.UNDER_REVIEW: {GrantStatus.APPROVED, GrantStatus.REJECTED, GrantStatus.WITHDRAWN},
    GrantStatus.APPROVED: set(),
    GrantStatus.REJECTED: {GrantStatus.DRAFT},
    GrantStatus.WITHDRAWN: {GrantStatus.DRAFT},
}


@dataclass
class StatusChange:
    from_status: str
    to_status: str
    changed_at: str
    note: str = ""

    def to_dict(self) -> dict:
        return {
            "from_status": self.from_status,
            "to_status": self.to_status,
            "changed_at": self.changed_at,
            "note": self.note,
        }

    @classmethod
    def from_dict(cls, data: dict) -> StatusChange:
        return cls(
            from_status=data["from_status"],
            to_status=data["to_status"],
            changed_at=data["changed_at"],
            note=data.get("note", ""),
        )


@dataclass
class GrantApplication:
    grant_name: str
    funder: str
    applicant: str
    amount_requested: float
    deadline: date
    project_summary: str = ""
    status: GrantStatus = GrantStatus.DRAFT
    amount_awarded: Optional[float] = None
    submitted_date: Optional[date] = None
    decision_date: Optional[date] = None
    notes: str = ""
    id: str = field(default_factory=lambda: datetime.now().strftime("%Y%m%d%H%M%S%f"))
    created_at: str = field(default_factory=lambda: datetime.now().strftime(DATETIME_FORMAT))
    history: list[StatusChange] = field(default_factory=list)

    def to_dict(self) -> dict:
        return {
            "id": self.id,
            "grant_name": self.grant_name,
            "funder": self.funder,
            "applicant": self.applicant,
            "amount_requested": self.amount_requested,
            "amount_awarded": self.amount_awarded,
            "deadline": self.deadline.strftime(DATE_FORMAT),
            "submitted_date": self.submitted_date.strftime(DATE_FORMAT) if self.submitted_date else None,
            "decision_date": self.decision_date.strftime(DATE_FORMAT) if self.decision_date else None,
            "project_summary": self.project_summary,
            "status": self.status.value,
            "notes": self.notes,
            "created_at": self.created_at,
            "history": [entry.to_dict() for entry in self.history],
        }

    @classmethod
    def from_dict(cls, data: dict) -> GrantApplication:
        return cls(
            id=data["id"],
            grant_name=data["grant_name"],
            funder=data["funder"],
            applicant=data["applicant"],
            amount_requested=float(data["amount_requested"]),
            amount_awarded=float(data["amount_awarded"]) if data.get("amount_awarded") is not None else None,
            deadline=datetime.strptime(data["deadline"], DATE_FORMAT).date(),
            submitted_date=(
                datetime.strptime(data["submitted_date"], DATE_FORMAT).date()
                if data.get("submitted_date")
                else None
            ),
            decision_date=(
                datetime.strptime(data["decision_date"], DATE_FORMAT).date()
                if data.get("decision_date")
                else None
            ),
            project_summary=data.get("project_summary", ""),
            status=GrantStatus(data["status"]),
            notes=data.get("notes", ""),
            created_at=data.get("created_at", datetime.now().strftime(DATETIME_FORMAT)),
            history=[StatusChange.from_dict(entry) for entry in data.get("history", [])],
        )


class GrantsManager:
    def __init__(self, data_file: Path = DATA_FILE) -> None:
        self.data_file = data_file
        self.applications: list[GrantApplication] = []
        self.load()

    def load(self) -> None:
        if not self.data_file.exists():
            self.applications = []
            return
        try:
            raw = json.loads(self.data_file.read_text(encoding="utf-8"))
            self.applications = [GrantApplication.from_dict(item) for item in raw]
            self.applications.sort(key=lambda g: g.deadline)
        except (json.JSONDecodeError, KeyError, ValueError) as exc:
            print(f"Warning: could not load grants data ({exc}). Starting fresh.")
            self.applications = []

    def save(self) -> None:
        payload = [app.to_dict() for app in self.applications]
        self.data_file.write_text(json.dumps(payload, indent=2), encoding="utf-8")

    def add_application(
        self,
        grant_name: str,
        funder: str,
        applicant: str,
        amount_requested: float,
        deadline: date,
        project_summary: str = "",
        notes: str = "",
    ) -> GrantApplication:
        app = GrantApplication(
            grant_name=grant_name,
            funder=funder,
            applicant=applicant,
            amount_requested=amount_requested,
            deadline=deadline,
            project_summary=project_summary,
            notes=notes,
        )
        app.history.append(
            StatusChange(
                from_status="",
                to_status=GrantStatus.DRAFT.value,
                changed_at=datetime.now().strftime(DATETIME_FORMAT),
                note="Application created",
            )
        )
        self.applications.append(app)
        self.applications.sort(key=lambda g: g.deadline)
        self.save()
        return app

    def find(self, app_id: str) -> Optional[GrantApplication]:
        for app in self.applications:
            if app.id == app_id:
                return app
        return None

    def delete(self, app_id: str) -> bool:
        before = len(self.applications)
        self.applications = [a for a in self.applications if a.id != app_id]
        if len(self.applications) == before:
            return False
        self.save()
        return True

    def by_status(self, status: GrantStatus) -> list[GrantApplication]:
        return [a for a in self.applications if a.status == status]

    def upcoming_deadlines(self, within_days: int = 30) -> list[GrantApplication]:
        today = date.today()
        cutoff = today.toordinal() + within_days
        active = {GrantStatus.DRAFT, GrantStatus.SUBMITTED, GrantStatus.UNDER_REVIEW}
        return [
            a
            for a in self.applications
            if a.status in active and today.toordinal() <= a.deadline.toordinal() <= cutoff
        ]

    def update_status(
        self,
        app: GrantApplication,
        new_status: GrantStatus,
        note: str = "",
        amount_awarded: Optional[float] = None,
    ) -> None:
        if new_status == app.status:
            raise ValueError(f"Application is already {app.status.label}.")

        allowed = VALID_TRANSITIONS.get(app.status, set())
        if new_status not in allowed:
            allowed_labels = ", ".join(s.label for s in sorted(allowed, key=lambda s: s.value)) or "none"
            raise ValueError(
                f"Cannot move from {app.status.label} to {new_status.label}. "
                f"Allowed next steps: {allowed_labels}."
            )

        old_status = app.status
        app.status = new_status
        app.history.append(
            StatusChange(
                from_status=old_status.value,
                to_status=new_status.value,
                changed_at=datetime.now().strftime(DATETIME_FORMAT),
                note=note,
            )
        )

        if new_status == GrantStatus.SUBMITTED and app.submitted_date is None:
            app.submitted_date = date.today()

        if new_status in {GrantStatus.APPROVED, GrantStatus.REJECTED}:
            app.decision_date = date.today()

        if new_status == GrantStatus.APPROVED:
            if amount_awarded is None:
                raise ValueError("Approved grants require an awarded amount.")
            if amount_awarded < 0:
                raise ValueError("Awarded amount cannot be negative.")
            app.amount_awarded = amount_awarded

        if new_status == GrantStatus.DRAFT:
            app.submitted_date = None
            app.decision_date = None
            if old_status != GrantStatus.REJECTED:
                app.amount_awarded = None

        self.save()



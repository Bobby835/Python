    def show_dashboard(self) -> None:
        self.current_view = "dashboard"
        self.apps_frame.pack_forget()
        self.dashboard_frame.pack(fill="both", expand=True)
        self.refresh_dashboard()

    def show_applications(self) -> None:
        self.current_view = "applications"
        self.dashboard_frame.pack_forget()
        self.apps_frame.pack(fill="both", expand=True)
        self.refresh_table()

    def refresh_all(self) -> None:
        if self.current_view == "dashboard":
            self.refresh_dashboard()
        else:
            self.refresh_table()

    def refresh_dashboard(self) -> None:
        apps = self.manager.applications
        active = [a for a in apps if a.status in {GrantStatus.DRAFT, GrantStatus.SUBMITTED, GrantStatus.UNDER_REVIEW}]
        approved = self.manager.by_status(GrantStatus.APPROVED)

        self.stat_card_vars["total"].set(str(len(apps)))
        self.stat_card_vars["active"].set(str(len(active)))
        self.stat_card_vars["requested"].set(format_money(sum(a.amount_requested for a in active)))
        self.stat_card_vars["awarded"].set(format_money(sum(a.amount_awarded or 0 for a in approved)))

        self.status_list.delete(0, tk.END)
        for status in GrantStatus:
            count = len(self.manager.by_status(status))
            if count:
                self.status_list.insert(tk.END, f"  {status.label}: {count}")

        self.deadline_list.delete(0, tk.END)
        upcoming = sorted(self.manager.upcoming_deadlines(30), key=lambda a: a.deadline)
        if not upcoming:
            self.deadline_list.insert(tk.END, "  No upcoming deadlines")
        for app in upcoming:
            self.deadline_list.insert(tk.END, f"  {app.grant_name} — {deadline_label(app)}")

    def _filtered_apps(self) -> list[GrantApplication]:
        query = self.search_var.get().strip().lower()
        status_filter = self.filter_var.get()

        apps = self.manager.applications
        if status_filter != "All":
            apps = [a for a in apps if a.status.label == status_filter]
        if query:
            apps = [
                a
                for a in apps
                if query in a.grant_name.lower()
                or query in a.funder.lower()
                or query in a.applicant.lower()
            ]
        return apps

    def refresh_table(self) -> None:
        selected = self.selected_id
        for row in self.tree.get_children():
            self.tree.delete(row)

        visible_ids: list[str] = []
        for app in self._filtered_apps():
            tags = ()
            if app.status in {GrantStatus.DRAFT, GrantStatus.SUBMITTED, GrantStatus.UNDER_REVIEW}:
                if days_until(app.deadline) < 0:
                    tags = ("overdue",)
            self.tree.insert(
                "",
                tk.END,
                iid=app.id,
                values=(
                    app.grant_name,
                    app.funder,
                    app.status.label,
                    format_money(app.amount_requested),
                    deadline_label(app),
                ),
                tags=tags,
            )
            visible_ids.append(app.id)

        if selected and selected in visible_ids:
            self.tree.selection_set(selected)
            self.tree.focus(selected)
        else:
            self.selected_id = None
            self._show_detail(None)

    def _on_select(self, _event: Optional[tk.Event] = None) -> None:
        selection = self.tree.selection()
        if not selection:
            self.selected_id = None
            self._show_detail(None)
            return
        self.selected_id = selection[0]
        app = self.manager.find(self.selected_id)
        self._show_detail(app)

    def _show_detail(self, app: Optional[GrantApplication]) -> None:
        if not app:
            self.detail_title.configure(text="Select an application")
            self.detail_body.configure(text="Click a row in the table to view details, update status, or delete.")
            self.history_box.configure(state="normal")
            self.history_box.delete("1.0", tk.END)
            self.history_box.configure(state="disabled")
            self.status_button.configure(state="disabled")
            self.delete_button.configure(state="disabled")
            return

        self.detail_title.configure(text=app.grant_name)
        lines = [
            f"Funder: {app.funder}",
            f"Applicant: {app.applicant}",
            f"Status: {app.status.label}",
            f"Requested: {format_money(app.amount_requested)}",
            f"Deadline: {deadline_label(app)}",
        ]
        if app.amount_awarded is not None:
            lines.append(f"Awarded: {format_money(app.amount_awarded)}")
        if app.submitted_date:
            lines.append(f"Submitted: {app.submitted_date.strftime(DATE_FORMAT)}")
        if app.decision_date:
            lines.append(f"Decision: {app.decision_date.strftime(DATE_FORMAT)}")
        if app.project_summary:
            lines.append(f"\nSummary:\n{app.project_summary}")
        if app.notes:
            lines.append(f"\nNotes:\n{app.notes}")

        self.detail_body.configure(text="\n".join(lines))

        self.history_box.configure(state="normal")
        self.history_box.delete("1.0", tk.END)
        self.history_box.insert(tk.END, "Status History\n" + ("-" * 28) + "\n")
        for entry in app.history:
            if entry.from_status:
                note = f" — {entry.note}" if entry.note else ""
                self.history_box.insert(tk.END, f"{entry.changed_at}\n  {entry.from_status} → {entry.to_status}{note}\n\n")
            else:
                self.history_box.insert(tk.END, f"{entry.changed_at}\n  Created — {entry.note or 'Application created'}\n\n")
        self.history_box.configure(state="disabled")

        allowed = VALID_TRANSITIONS.get(app.status, set())
        self.status_button.configure(state="normal" if allowed else "disabled")
        self.delete_button.configure(state="normal")

    def open_create_dialog(self) -> None:
        dialog = tk.Toplevel(self.root)
        dialog.title("New Grant Application")
        dialog.geometry("480x520")
        dialog.transient(self.root)
        dialog.grab_set()
        dialog.resizable(False, False)

        form = ttk.Frame(dialog, padding=24)
        form.pack(fill="both", expand=True)

        fields: dict[str, tk.Variable] = {
            "grant_name": tk.StringVar(),
            "funder": tk.StringVar(),
            "applicant": tk.StringVar(value="Your name"),
            "amount": tk.StringVar(value="10000"),
            "deadline": tk.StringVar(value=date.today().strftime(DATE_FORMAT)),
            "summary": tk.StringVar(),
            "notes": tk.StringVar(),
        }

        def add_field(row: int, label: str, key: str, height: int = 1) -> None:
            ttk.Label(form, text=label).grid(row=row, column=0, sticky="nw", pady=6)
            if height > 1:
                widget = tk.Text(form, height=height, width=36, font=("Helvetica", 11))
                widget.grid(row=row, column=1, sticky="ew", pady=6)
                fields[key] = widget  # type: ignore[assignment]
            else:
                ttk.Entry(form, textvariable=fields[key], width=38).grid(row=row, column=1, sticky="ew", pady=6)

        add_field(0, "Grant name *", "grant_name")
        add_field(1, "Funder *", "funder")
        add_field(2, "Applicant *", "applicant")
        add_field(3, "Amount requested ($) *", "amount")
        add_field(4, "Deadline (YYYY-MM-DD) *", "deadline")
        add_field(5, "Project summary", "summary", height=3)
        add_field(6, "Internal notes", "notes", height=3)
        form.columnconfigure(1, weight=1)

        def save() -> None:
            grant_name = fields["grant_name"].get().strip()
            funder = fields["funder"].get().strip()
            applicant = fields["applicant"].get().strip()
            if not grant_name or not funder or not applicant:
                messagebox.showerror("Missing fields", "Grant name, funder, and applicant are required.", parent=dialog)
                return
            try:
                amount = parse_amount(fields["amount"].get(), "Amount requested")
                deadline = parse_date(fields["deadline"].get(), "Deadline")
            except ValueError as exc:
                messagebox.showerror("Invalid input", str(exc), parent=dialog)
                return

            summary_widget = fields["summary"]
            notes_widget = fields["notes"]
            summary = summary_widget.get("1.0", tk.END).strip() if isinstance(summary_widget, tk.Text) else ""
            notes = notes_widget.get("1.0", tk.END).strip() if isinstance(notes_widget, tk.Text) else ""

            app = self.manager.add_application(
                grant_name=grant_name,
                funder=funder,
                applicant=applicant,
                amount_requested=amount,
                deadline=deadline,
                project_summary=summary,
                notes=notes,
            )
            dialog.destroy()
            self.show_applications()
            self.selected_id = app.id
            self.refresh_all()
            messagebox.showinfo("Created", f"Draft application created:\n{app.grant_name}")

        buttons = ttk.Frame(form)
        buttons.grid(row=7, column=0, columnspan=2, sticky="e", pady=(16, 0))
        ttk.Button(buttons, text="Cancel", command=dialog.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(buttons, text="Create Application", style="Primary.TButton", command=save).pack(side="right")

    def open_status_dialog(self) -> None:
        if not self.selected_id:
            return
        app = self.manager.find(self.selected_id)
        if not app:
            return

        allowed = sorted(VALID_TRANSITIONS.get(app.status, set()), key=lambda s: s.value)
        if not allowed:
            messagebox.showinfo("No changes", f"This application is already {app.status.label}.")
            return

        dialog = tk.Toplevel(self.root)
        dialog.title("Update Status")
        dialog.geometry("420x320")
        dialog.transient(self.root)
        dialog.grab_set()

        frame = ttk.Frame(dialog, padding=24)
        frame.pack(fill="both", expand=True)

        ttk.Label(frame, text=app.grant_name, font=("Helvetica", 13, "bold")).pack(anchor="w")
        ttk.Label(frame, text=f"Current status: {app.status.label}").pack(anchor="w", pady=(4, 12))

        ttk.Label(frame, text="Move to:").pack(anchor="w")
        status_var = tk.StringVar(value=allowed[0].label)
        ttk.Combobox(
            frame,
            textvariable=status_var,
            values=[s.label for s in allowed],
            state="readonly",
        ).pack(fill="x", pady=(4, 12))

        ttk.Label(frame, text="Note (optional):").pack(anchor="w")
        note_box = tk.Text(frame, height=4, font=("Helvetica", 11))
        note_box.pack(fill="x", pady=(4, 12))

        award_frame = ttk.Frame(frame)
        ttk.Label(award_frame, text="Amount awarded ($):").pack(side="left")
        award_var = tk.StringVar(value=str(app.amount_requested))
        award_entry = ttk.Entry(award_frame, textvariable=award_var, width=16)
        award_entry.pack(side="left", padx=(8, 0))

        label_to_status = {s.label: s for s in GrantStatus}

        def toggle_award(*_args: object) -> None:
            if status_var.get() == GrantStatus.APPROVED.label:
                award_frame.pack(fill="x", pady=(0, 12))
            else:
                award_frame.pack_forget()

        status_var.trace_add("write", toggle_award)
        toggle_award()

        def apply() -> None:
            new_status = label_to_status[status_var.get()]
            note = note_box.get("1.0", tk.END).strip()
            amount_awarded: Optional[float] = None
            if new_status == GrantStatus.APPROVED:
                try:
                    amount_awarded = parse_amount(award_var.get(), "Amount awarded")
                except ValueError as exc:
                    messagebox.showerror("Invalid input", str(exc), parent=dialog)
                    return
            try:
                self.manager.update_status(app, new_status, note=note, amount_awarded=amount_awarded)
            except ValueError as exc:
                messagebox.showerror("Cannot update", str(exc), parent=dialog)
                return
            dialog.destroy()
            self.refresh_all()
            self._on_select()
            messagebox.showinfo("Updated", f"Status updated to {new_status.label}.")

        btn_row = ttk.Frame(frame)
        btn_row.pack(fill="x")
        ttk.Button(btn_row, text="Cancel", command=dialog.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(btn_row, text="Apply", style="Primary.TButton", command=apply).pack(side="right")

    def delete_selected(self) -> None:
        if not self.selected_id:
            return
        app = self.manager.find(self.selected_id)
        if not app:
            return
        if not messagebox.askyesno("Delete application", f"Delete '{app.grant_name}'?\nThis cannot be undone."):
            return
        self.manager.delete(app.id)
        self.selected_id = None
        self.refresh_all()
        self._show_detail(None)


def main() -> None:
    root = tk.Tk()
    GrantsApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()

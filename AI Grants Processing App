def parse_date(value: str, label: str = "Date") -> date:
    try:
        return datetime.strptime(value.strip(), DATE_FORMAT).date()
    except ValueError as exc:
        raise ValueError(f"{label} must be in YYYY-MM-DD format.") from exc


def parse_amount(value: str, label: str = "Amount") -> float:
    try:
        amount = float(value.replace(",", "").replace("$", "").strip())
    except ValueError as exc:
        raise ValueError(f"{label} must be a number.") from exc
    if amount < 0:
        raise ValueError(f"{label} cannot be negative.")
    return amount


def format_money(amount: float) -> str:
    return f"${amount:,.2f}"


def days_until(deadline: date) -> int:
    return (deadline - date.today()).days


def deadline_label(app: GrantApplication) -> str:
    text = app.deadline.strftime(DATE_FORMAT)
    if app.status not in {GrantStatus.DRAFT, GrantStatus.SUBMITTED, GrantStatus.UNDER_REVIEW}:
        return text
    days = days_until(app.deadline)
    if days < 0:
        return f"{text} (overdue)"
    if days == 0:
        return f"{text} (today)"
    if days <= 7:
        return f"{text} ({days}d left)"
    return text


class ScrollableFrame(ttk.Frame):
    def __init__(self, parent: tk.Misc, **kwargs) -> None:
        super().__init__(parent, **kwargs)
        canvas = tk.Canvas(self, highlightthickness=0, borderwidth=0)
        scrollbar = ttk.Scrollbar(self, orient="vertical", command=canvas.yview)
        self.inner = ttk.Frame(canvas)
        self.inner.bind(
            "<Configure>",
            lambda _event: canvas.configure(scrollregion=canvas.bbox("all")),
        )
        canvas.create_window((0, 0), window=self.inner, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        def _on_mousewheel(event: tk.Event) -> None:
            canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")

        canvas.bind_all("<MouseWheel>", _on_mousewheel)


